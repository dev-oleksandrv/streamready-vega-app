# Ad tags (VAST ad server tag URLs), read at build time by scripts/ad-config.mjs.
# Copy to .env and fill in. An empty or missing tag switches that slot off: no tags = ad-free app.
# Only https:// URLs are accepted. Never put anything with admin or billing access here:
# whatever the app bundles can be extracted. See docs/adr/0013-vast-ads.md.
SR_AD_TAG_RESULT=
SR_AD_TAG_HOME=
SR_AD_TAG_VIDEO=
