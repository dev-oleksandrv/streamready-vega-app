{
  "name": "@voronkov/streamready",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "dev": "scripts/dev.sh",
    "test": "jest --colors",
    "test:coverage": "jest --colors --coverage",
    "lint": "eslint src test index.js babel.config.js metro.config.js package.json --ext .ts,.tsx",
    "lint:fix": "eslint src test index.js babel.config.js metro.config.js package.json --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "check": "npm-run-all lint typecheck test test:native",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all check build:app",
    "codegen:ndt7": "keplerscript-turbomodule-api codegen src/modules/speedtest/engines/ndt7native/NativeNdt7.ts -o kepler/turbo-modules/ -s Ndt7TurboModule -c Ndt7Native",
    "test:native": "scripts/test-native.sh"
  },
  "dependencies": {
    "@amazon-devices/keplerscript-turbomodule-api": "1.2.5",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-safe-area-context": "~8.0.0",
    "@amazon-devices/react-native-screens": "~3.0.0",
    "@amazon-devices/react-navigation__native": "~8.0.0",
    "@amazon-devices/react-navigation__native-stack": "~8.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "streamready",
    "targets": [
      "tv"
    ]
  }
}
