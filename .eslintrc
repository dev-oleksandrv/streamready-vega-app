{
  "plugins": [
    "@typescript-eslint",
    "@amazon-devices/eslint-plugin-kepler"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended",
    "plugin:@amazon-devices/eslint-plugin-kepler/kepler"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "~/modules/*/**",
              "../**/modules/*/**"
            ],
            "message": "Use '~/modules/<name>' for other modules and relative imports inside a module."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    },
    {
      "files": [
        "src/modules/*/domain/**",
        "src/modules/verdict/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "domain/ and verdict/ are pure TypeScript."
              },
              {
                "name": "react-native",
                "message": "domain/ and verdict/ are pure TypeScript."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@amazon-devices/*",
                  "react/*",
                  "react-native/*",
                  "react-native-*",
                  "@react-native/*"
                ],
                "message": "domain/ and verdict/ are pure TypeScript."
              },
              {
                "group": [
                  "~/modules/*/**",
                  "../**/modules/*/**"
                ],
                "message": "Use '~/modules/<name>' for other modules and relative imports inside a module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/app",
                  "~/app/**",
                  "~/modules",
                  "~/modules/**",
                  "../**/app",
                  "../**/app/**",
                  "../**/modules",
                  "../**/modules/**"
                ],
                "message": "shared/ must not depend on modules/ or app/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "test/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "package.json",
        "kepler-compatibility.json"
      ],
      "parser": "jsonc-eslint-parser"
    },
    {
      "files": [
        "*.config.js",
        "index.js"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
